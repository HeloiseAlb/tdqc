+def tensor_prod(*arg):
+    """
+    tensor_prod(a1, a2) = np.kron(a1, a2).
+    tensor_prod(a1, a2, ..., an) = np.kron(tensor_prod(a1, ..., an-1), an)
+    """
+    res = arg[0]
+    for i in range(1, len(arg)):
+        res = np.kron(res, arg[i])
+    return res
